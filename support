<style>
@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap');

:root {
  --eu-blue: #003399;
  --eu-yellow: #FFCC00;
  --bg-light: #f3f6f7;
  --text-dark: #333333;
  --text-muted: #666666;
  --border: #d8dee4;
  --danger: #d43c39;
  --success: #2e7d32;
  --warning: #f59e0b;
}

body { 
  background-color: #fff; 
  color: var(--text-dark); 
  font-family: 'Roboto', sans-serif; 
  margin: 0; 
  line-height: 1.5; 
}

.eu-top-banner { 
  background: #fff; 
  padding: 8px 10%; 
  border-bottom: 1px solid var(--border); 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  font-size: 12px; 
  color: var(--text-muted); 
}

.lang-select { 
  padding: 3px 8px; 
  font-size: 12px; 
  border: 1px solid var(--border); 
  border-radius: 2px; 
  background: #fff; 
  cursor: pointer; 
  color: var(--text-dark); 
}

header { 
  padding: 20px 10%; 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  background: #fff; 
  border-bottom: 1px solid var(--border); 
}

.brand { 
  display: flex; 
  align-items: center; 
  gap: 20px; 
}

.brand img { 
  width: 75px; 
}

.brand-titles { 
  border-left: 1px solid var(--border); 
  padding-left: 20px; 
}

.brand-titles h1 { 
  margin: 0; 
  font-size: 20px; 
  color: var(--eu-blue); 
  font-weight: 700; 
}

/* Center Content Area */
.main-content { 
  max-width: 800px; 
  margin: 60px auto; 
  padding: 0 20px; 
  min-height: 500px; 
}

.card { 
  background: #fff; 
  border: 1px solid var(--border); 
  padding: 40px; 
  border-radius: 4px; 
  box-shadow: 0 4px 20px rgba(0,0,0,0.06); 
}

.officer-profile-header {
  display: flex;
  align-items: center;
  gap: 20px;
  border-bottom: 2px solid var(--eu-blue);
  padding-bottom: 20px;
  margin-bottom: 30px;
}

.officer-avatar {
  width: 70px;
  height: 70px;
  background-color: var(--eu-blue);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
}

.officer-title-group h2 {
  margin: 0;
  color: var(--eu-blue);
  font-size: 24px;
  font-weight: 700;
}

.officer-title-group p {
  margin: 4px 0 0 0;
  font-size: 16px;
  color: var(--text-muted);
  font-weight: 500;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 15px;
  background: #f8fafc;
  padding: 18px 20px;
  border: 1px solid var(--border);
  border-radius: 4px;
  position: relative;
}

.info-item i.icon-left {
  font-size: 20px;
  color: var(--eu-blue);
  margin-top: 3px;
}

.info-text label {
  display: block;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-muted);
  font-weight: 700;
  margin-bottom: 3px;
}

.info-text span, .info-text a {
  font-size: 16px;
  color: var(--text-dark);
  font-weight: 500;
  text-decoration: none;
}

.info-text a:hover {
  color: var(--eu-blue);
  text-decoration: underline;
}

/* Copy Button */
.copy-btn {
  margin-left: auto;
  background: none;
  border: none;
  color: var(--eu-blue);
  cursor: pointer;
  font-size: 18px;
  padding: 4px 8px;
  border-radius: 4px;
  transition: background 0.2s, color 0.2s;
  align-self: center;
}

.copy-btn:hover {
  background-color: #e0e8f5;
  color: #002673;
}

/* ESMA Footer Styles */
.esma-footer {
  background-color: #E2E2EC;
  padding: 40px 10%;
  margin-top: 80px;
  font-family: "Open Sans", Arial, sans-serif;
  box-sizing: border-box;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  max-width: 1400px;
  margin: 0 auto;
  gap: 30px;
}

.footer-brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 15px;
}

.footer-logo {
  height: 60px;
  width: auto;
  display: block;
}

.eu-banner {
  background-color: #2A00A0;
  color: #FFFFFF;
  font-size: 12px;
  padding: 6px 12px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.eu-flag-icon {
  width: 22px;
  height: 15px;
  display: inline-block;
  vertical-align: middle;
}

.footer-links {
  display: grid;
  grid-template-columns: repeat(3, minmax(140px, auto));
  column-gap: 50px;
  row-gap: 25px;
  align-items: center;
}

.footer-links a, .footer-links a:visited, .footer-links a:hover, .footer-links a:active {
  color: #0055CC !important;
  font-size: 15px;
  font-weight: 400;
  text-decoration: none !important;
  white-space: nowrap;
}

.footer-links a:hover {
  text-decoration: underline !important;
}

.footer-social {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.social-heading {
  color: #0055CC;
  font-size: 16px;
  font-weight: 700;
  margin: 0;
}

.social-icons {
  display: flex;
  gap: 12px;
  align-items: center;
}

.social-icons a {
  color: #E65100;
  font-size: 24px;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.social-icons a:hover {
  opacity: 0.8;
}

@media (max-width: 900px) {
  .footer-content {
    flex-direction: column;
    align-items: flex-start;
  }
  .footer-links {
    grid-template-columns: 1fr;
    gap: 15px;
  }
}
</style>
