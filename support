function initPortal() {
  const userLang = (navigator.language || navigator.userLanguage || "").substring(0, 2).toLowerCase();
  const langMap = { 
    "da": "DA", "de": "DE", "nl": "DU", "es": "ES", 
    "fi": "FI", "fr": "FR", "it": "IT", "no": "NO", 
    "nb": "NO", "nn": "NO", "sv": "SV" 
  };
  
  if (langMap[userLang]) {
    currentLang = langMap[userLang];
    document.getElementById('langSelect').value = currentLang;
  }
  changeLanguage(currentLang);
}

function changeLanguage(lang) {
  currentLang = lang;
  const dict = i18n[lang] || i18n.ENG;

  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (dict[key]) {
      el.innerHTML = dict[key];
    }
  });
}

function copyText(elementId) {
  const emailText = document.getElementById(elementId).innerText;
  navigator.clipboard.writeText(emailText);
  const dict = i18n[currentLang] || i18n.ENG;
  alert(dict.msgCopied || "Email address copied to clipboard.");
}
